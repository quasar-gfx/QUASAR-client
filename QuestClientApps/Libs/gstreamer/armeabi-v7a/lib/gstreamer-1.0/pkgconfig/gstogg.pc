prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstogg
Description: gst-plugins-base: gstogg
Version: 1.27.1
Requires.private: gstreamer-audio-1.0, gstreamer-tag-1.0, gstreamer-pbutils-1.0, gstreamer-video-1.0, gstreamer-riff-1.0, ogg >= 1.0, gstreamer-base-1.0 >=  1.27.1, zlib, orc-0.4 >=  0.4.34, gstreamer-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstogg
Libs.private: -lm
Cflags: -I${includedir}

