prefix=${pcfiledir}/../../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstmpegtslive
Description: GStreamer MPEG-TS Live sources
Version: 0.14.0-alpha.1
Libs: -L${libdir}/gstreamer-1.0 -lgstmpegtslive -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lgio-2.0 -ldl -llog -lunwind -lm -lc
Cflags: 
Libs.private: -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lgio-2.0 -ldl -llog -lunwind -lm -lc
Requires.private: gstreamer-1.0, gstreamer-base-1.0, gobject-2.0, glib-2.0, gmodule-2.0

