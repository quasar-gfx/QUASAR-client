Description: gst-plugins-good: gstavi
Version: 1.27.1
Requires.private: gstreamer-1.0 >=  1.27.1, gstreamer-riff-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstavi
Cflags: -I${includedir}

