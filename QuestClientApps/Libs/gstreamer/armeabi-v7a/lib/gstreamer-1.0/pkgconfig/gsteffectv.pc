Description: gst-plugins-good: gsteffectv
Version: 1.27.1
Requires.private: gstreamer-1.0 >=  1.27.1, gstreamer-base-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgsteffectv
Libs.private: -lm
Cflags: -I${includedir}

