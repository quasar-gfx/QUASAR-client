prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstasf
Description: gst-plugins-ugly: gstasf
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-rtp-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gstreamer-riff-1.0 >=  1.27.1, gstreamer-rtsp-1.0 >=  1.27.1, gstreamer-sdp-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstasf
Cflags: -I${includedir}

