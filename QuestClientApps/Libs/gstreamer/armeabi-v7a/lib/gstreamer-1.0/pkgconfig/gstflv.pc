prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstflv
Description: gst-plugins-good: gstflv
Version: 1.27.1
Requires.private: gstreamer-pbutils-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstflv
Cflags: -I${includedir}

