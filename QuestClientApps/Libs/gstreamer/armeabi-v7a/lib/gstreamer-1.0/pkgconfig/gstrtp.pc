prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstrtp
Description: gst-plugins-good: gstrtp
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gstreamer-rtp-1.0 >=  1.27.1, gstreamer-pbutils-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstrtp
Libs.private: -lm
Cflags: -I${includedir}

