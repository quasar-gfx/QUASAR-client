prefix=${pcfiledir}/../../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstrsrtsp
Description: GStreamer RTSP Client Plugin
Version: 0.14.0-alpha.1
Libs: -L${libdir}/gstreamer-1.0 -lgstrsrtsp -lgstpbutils-1.0 -lgstvideo-1.0 -lgstaudio-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lgstapp-1.0 -lgstnet-1.0 -lgio-2.0 -ldl -llog -lunwind -lm -lc
Cflags: 
Libs.private: -lgstpbutils-1.0 -lgstvideo-1.0 -lgstaudio-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lgstapp-1.0 -lgstnet-1.0 -lgio-2.0 -ldl -llog -lunwind -lm -lc
Requires.private: gstreamer-1.0, gstreamer-net-1.0, gobject-2.0, glib-2.0, gmodule-2.0

