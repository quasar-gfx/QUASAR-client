prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstspeex
Description: gst-plugins-good: gstspeex
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, speex >= 1.1.6
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstspeex
Libs.private: -lm
Cflags: -I${includedir}

