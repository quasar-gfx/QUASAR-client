prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstdv
Description: gst-plugins-good: gstdv
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, libdv >=  0.100
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstdv
Cflags: -I${includedir}

