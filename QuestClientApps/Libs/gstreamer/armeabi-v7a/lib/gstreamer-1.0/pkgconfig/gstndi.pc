prefix=${pcfiledir}/../../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstndi
Description: GStreamer NewTek NDI Plugin
Version: 0.14.0-alpha.1
Libs: -L${libdir}/gstreamer-1.0 -lgstndi -lgstaudio-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -ldl -lgstvideo-1.0 -lgio-2.0 -llog -lunwind -lm -lc
Cflags: 
Libs.private: -lgstaudio-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -ldl -lgstvideo-1.0 -lgio-2.0 -llog -lunwind -lm -lc
Requires.private: gstreamer-1.0, gstreamer-base-1.0, gstreamer-audio-1.0, gstreamer-video-1.0, gobject-2.0, glib-2.0, gmodule-2.0

