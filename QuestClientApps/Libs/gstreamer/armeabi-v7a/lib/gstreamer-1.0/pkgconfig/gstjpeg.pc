prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstjpeg
Description: gst-plugins-good: gstjpeg
Version: 1.27.1
Requires.private: gstreamer-1.0 >=  1.27.1, gstreamer-base-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, libjpeg
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstjpeg
Libs.private: -lm
Cflags: -I${includedir}

