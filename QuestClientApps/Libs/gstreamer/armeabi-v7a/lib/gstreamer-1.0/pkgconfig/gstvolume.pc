prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstvolume
Description: gst-plugins-base: gstvolume
Version: 1.27.1
Requires.private: gstreamer-audio-1.0, gstreamer-tag-1.0, gstreamer-base-1.0 >=  1.27.1, zlib, orc-0.4 >=  0.4.34, gstreamer-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstvolume
Libs.private: -lm
Cflags: -I${includedir}

