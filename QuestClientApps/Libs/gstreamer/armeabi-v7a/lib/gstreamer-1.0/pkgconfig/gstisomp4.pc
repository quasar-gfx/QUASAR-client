prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstisomp4
Description: gst-plugins-good: gstisomp4
Version: 1.27.1
Requires.private: gstreamer-1.0 >=  1.27.1, gstreamer-riff-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, gstreamer-rtp-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gstreamer-pbutils-1.0 >=  1.27.1, zlib
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstisomp4
Cflags: -I${includedir}

