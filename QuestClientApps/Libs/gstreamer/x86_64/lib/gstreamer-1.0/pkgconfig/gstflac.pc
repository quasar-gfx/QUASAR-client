prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstflac
Description: gst-plugins-good: gstflac
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, flac >= 1.1.4
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstflac
Cflags: -I${includedir}

