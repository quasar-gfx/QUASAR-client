prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstrtspclientsink
Description: gst-rtsp-server: gstrtspclientsink
Version: 1.27.1
Requires.private: gstreamer-rtsp-server-1.0, gstreamer-rtsp-1.0 >=  1.27.1, gstreamer-sdp-1.0 >=  1.27.1, gstreamer-rtp-1.0 >=  1.27.1, gstreamer-net-1.0 >=  1.27.1, gstreamer-app-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstrtspclientsink
Cflags: -I${includedir}

