prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstvpx
Description: gst-plugins-good: gstvpx
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, vpx >= 1.7.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstvpx
Cflags: -I${includedir}

