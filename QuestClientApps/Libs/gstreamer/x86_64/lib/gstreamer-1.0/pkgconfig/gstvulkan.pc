Requires.private: gstreamer-vulkan-1.0, gstreamer-video-1.0 >=  1.27.1, gstreamer-base-1.0 >=  1.27.1, gio-2.0 >=  2.64.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstvulkan
