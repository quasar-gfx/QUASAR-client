prefix=${pcfiledir}/../../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstrsclosedcaption
Description: GStreamer Rust Closed Caption Plugin
Version: 0.14.0-alpha.1
Libs: -L${libdir}/gstreamer-1.0 -lgstrsclosedcaption -lpangocairo-1.0 -lpango-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lharfbuzz -lcairo -lcairo-gobject -lgstvideo-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgio-2.0 -ldl -llog -lunwind -lm -lc
Cflags: 
Libs.private: -lpangocairo-1.0 -lpango-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lharfbuzz -lcairo -lcairo-gobject -lgstvideo-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgio-2.0 -ldl -llog -lunwind -lm -lc
Requires.private: gstreamer-1.0, gstreamer-base-1.0, gstreamer-video-1.0, gobject-2.0, glib-2.0, gmodule-2.0, pango, pangocairo, cairo-gobject

