prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstrawparse
Description: gst-plugins-base: gstrawparse
Version: 1.27.1
Requires.private: gstreamer-video-1.0, gstreamer-audio-1.0, gstreamer-tag-1.0, gstreamer-base-1.0 >=  1.27.1, orc-0.4 >=  0.4.34, zlib
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstrawparse
Libs.private: -lm
Cflags: -I${includedir}

