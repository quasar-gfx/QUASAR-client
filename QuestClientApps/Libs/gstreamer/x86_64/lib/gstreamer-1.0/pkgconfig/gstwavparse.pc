prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstwavparse
Description: gst-plugins-good: gstwavparse
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-pbutils-1.0 >=  1.27.1, gstreamer-riff-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstwavparse
Libs.private: -lm
Cflags: -I${includedir}

