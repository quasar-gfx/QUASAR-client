Description: gst-plugins-good: gstspectrum
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-fft-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstspectrum
Libs.private: -lm
Cflags: -I${includedir}

