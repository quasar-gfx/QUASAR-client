prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstclosedcaption
Description: gst-plugins-bad: gstclosedcaption
Version: 1.27.1
Requires.private: gstreamer-codecparsers-1.0, gstreamer-video-1.0 >=  1.27.1, gstreamer-base-1.0 >=  1.27.1, gstreamer-1.0 >=  1.27.1, pangocairo >= 1.22.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstclosedcaption
Libs.private: -lm -L${libdir} -lgstcodecs-1.0
Cflags: -I${includedir}

