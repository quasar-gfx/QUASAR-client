prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstcairo
Description: gst-plugins-good: gstcairo
Version: 1.27.1
Requires.private: gstreamer-base-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, cairo-gobject >= 1.10.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstcairo
Cflags: -I${includedir}

