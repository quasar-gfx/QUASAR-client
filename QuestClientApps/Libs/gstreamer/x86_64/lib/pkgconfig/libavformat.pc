prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: avformat
Description: Multimedia formats
Version: 61.7.100
Requires.private: libavcodec, libavutil, libswresample, zlib
Libs: -L${libdir} -lavformat
Libs.private: -Wl,-Bsymbolic -pthread -lm -landroid -latomic -lbz2
Cflags: -I${includedir}

