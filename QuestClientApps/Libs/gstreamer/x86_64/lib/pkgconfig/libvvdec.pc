prefix=${pcfiledir}/../..
exec_prefix=bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libvvdec
Description: Fraunhofer Versatile Video Decoder (VVdeC)
Version: 3.0.0
Libs: -L${libdir} -lvvdec
Libs.private: -lc++ -lm -l:libunwind.a -ldl -l:libunwind.a -ldl -pthread
Cflags: -I${includedir}

