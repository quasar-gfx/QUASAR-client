prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstreamer-rtsp-server-1.0
Description: GStreamer based RTSP server
Version: 1.27.1
Requires: gstreamer-1.0 >=  1.27.1
Requires.private: gstreamer-rtsp-1.0 >=  1.27.1, gstreamer-rtp-1.0 >=  1.27.1, gstreamer-sdp-1.0 >=  1.27.1, gstreamer-net-1.0 >=  1.27.1, gstreamer-app-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1
Libs: -L${libdir} -lgstrtspserver-1.0
Cflags: -I${includedir}/gstreamer-1.0

