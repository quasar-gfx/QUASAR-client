prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstlibav
Description: gst-libav: gstlibav
Version: 1.27.1
Requires.private: libavfilter >=  7.16.100, libavformat >=  58.12.100, libavcodec >=  58.18.100, libavutil >=  56.14.100, gstreamer-1.0 >=  1.27.1, gstreamer-base-1.0 >=  1.27.1, gstreamer-video-1.0 >=  1.27.1, gstreamer-audio-1.0 >=  1.27.1, gstreamer-pbutils-1.0 >=  1.27.1
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstlibav
Cflags: -I${includedir}

