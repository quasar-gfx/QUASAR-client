prefix=${pcfiledir}/../../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstquinn
Description: GStreamer Plugin for QUIC
Version: 0.14.0-alpha.1
Libs: -L${libdir}/gstreamer-1.0 -lgstquinn -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lgio-2.0 -ldl -llog -lunwind -lm -lc
Cflags: 
Libs.private: -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lgio-2.0 -ldl -llog -lunwind -lm -lc
Requires.private: gstreamer-1.0, gstreamer-base-1.0, gobject-2.0, glib-2.0

