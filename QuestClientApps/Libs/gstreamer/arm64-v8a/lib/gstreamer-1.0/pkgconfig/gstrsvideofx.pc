prefix=${pcfiledir}/../../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstrsvideofx
Description: GStreamer Rust Video Effects Plugin
Version: 0.14.0-alpha.1
Libs: -L${libdir}/gstreamer-1.0 -lgstrsvideofx -lcairo-gobject -lcairo -lgobject-2.0 -lglib-2.0 -lintl -lgstvideo-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgio-2.0 -ldl -llog -lunwind -lm -lc
Cflags: 
Libs.private: -lcairo-gobject -lcairo -lgobject-2.0 -lglib-2.0 -lintl -lgstvideo-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgio-2.0 -ldl -llog -lunwind -lm -lc
Requires.private: gstreamer-1.0, gstreamer-base-1.0, gstreamer-video-1.0, gobject-2.0, glib-2.0, cairo-gobject

