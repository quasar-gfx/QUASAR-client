prefix=${pcfiledir}/../../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gstsoup
Description: gst-plugins-good: gstsoup
Version: 1.27.1
Requires: gstreamer-1.0 >=  1.27.1, gstreamer-base-1.0 >=  1.27.1, gstreamer-tag-1.0 >=  1.27.1, gmodule-no-export-2.0, gio-2.0 >=  2.64.0, libsoup-3.0
Libs: -L${prefix}/lib/gstreamer-1.0 -lgstsoup -ldl
Cflags: -I${includedir}

